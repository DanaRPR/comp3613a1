{
  "info": {
    "name": "Student Awards API Tests",
    "description": "HTML-based regression checks for the Student Awards app. Postman follows redirects by default, so tests assert the final page. Default baseUrl targets http://127.0.0.1:8000. Demo accounts: bob/bobpass and admin/adminpass. Unauthenticated requests render the 401 page with status 200. The ID-1 approval, rejection, and redemption requests only test redirect behavior; they do not prove a record changed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "student-awards-api-tests"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "student_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Student Login (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "bob"
            },
            {
              "key": "password",
              "value": "bobpass"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('student login ends on the dashboard after redirect', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.include('Welcome, bob');",
              "});",
              "pm.test('student access token cookie is set', function () {",
              "  const token = pm.cookies.get('access_token');",
              "  pm.expect(token, 'access_token cookie exists').to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('student_access_token', token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
